SECRET_KEY=generate-with-python-secrets-token-hex-32
GROQ_API_KEY=gsk_your_api_key_here
GROQ_MODEL_ID=llama-3.3-70b-versatile
DATABASE_URL=sqlite:///crystalai_dev.db
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=vector_store
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE_MB=50
RAG_RELEVANCE_THRESHOLD=0.35
RAG_TOP_K=6
FLASK_ENV=development
FLASK_APP=run.py
AI_PROVIDER_CLASS=app.ai.groq_provider.GroqProvider

# Unlimited-OCR (self-hosted via vLLM/FastAPI — requires NVIDIA GPU)
# Set UNLIMITED_OCR_ENABLED=true only when the endpoint is running
UNLIMITED_OCR_ENABLED=false
UNLIMITED_OCR_URL=http://localhost:8000
UNLIMITED_OCR_API_KEY=
UNLIMITED_OCR_TIMEOUT=120
